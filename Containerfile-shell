FROM registry.access.redhat.com/hi/curl:latest-builder AS base

FROM base as builder
USER root
RUN dnf -y --setopt=install_weak_deps=0 --nodocs --use-host-config \
      --installroot /output \
      install \
      coreutils bash jq python ;\
      dnf -y clean all --enablerepo='*'

FROM registry.access.redhat.com/hi/curl:latest
COPY --from=builder /output /
COPY rh_errata_monitor.sh /usr/bin/rh_errata_monitor.sh

USER 65534
WORKDIR /app
ENV PATH=/usr/bin:/bin:/usr/sbin:/sbin:/app/bin
ENTRYPOINT [ "/usr/bin/rh_errata_monitor.sh" ]
CMD [ "monitor" ]
